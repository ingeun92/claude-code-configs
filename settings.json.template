{
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "language": "한국어",
  "effortLevel": "high",
  "advisorModel": "opus",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "theme": "dark",
  "autoCompactEnabled": true,
  "teammateMode": "auto",
  "skipAutoPermissionPrompt": true,
  "omcHud": {
    "preset": "focused",
    "elements": {
      "omcLabel": false,
      "model": false,
      "showCallCounts": false,
      "ralph": false,
      "autopilot": false,
      "prdStory": false,
      "cwd": true,
      "cwdFormat": "relative",
      "gitBranch": true,
      "gitStatus": true
    },
    "elementOrder": [
      "rateLimits",
      "contextBar"
    ]
  }
}
