{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{CLAUDE_HOME}}/hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "{{CLAUDE_HOME}}/hooks/bash-auto-allow.sh"
          },
          {
            "type": "command",
            "command": "{{CLAUDE_HOME}}/hooks/git-guard-hook.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ingeunkim/.local/bin/mempalace hook run --hook session-start --harness claude-code"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ingeunkim/.local/bin/mempalace hook run --hook stop --harness claude-code"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ingeunkim/.local/bin/mempalace hook run --hook precompact --harness claude-code"
          }
        ]
      }
    ]
  },
  "language": "한국어",
  "effortLevel": "medium"
}
