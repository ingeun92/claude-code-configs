{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node {{CLAUDE_HOME}}/scripts/statusline-hud.mjs",
    "padding": 0
  },
  "language": "한국어",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "fable",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "theme": "dark",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": true,
  "autoScrollEnabled": true,
  "teammateMode": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
